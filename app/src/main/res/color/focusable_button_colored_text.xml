<!-- res/color/focusable_text.xml -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- State when the button is pressed -->
    <item android:state_pressed="true" android:color="@color/white"/> <!-- Red when pressed -->

    <!-- State when the button is focused -->
    <item android:state_focused="true" android:color="@color/white"/>

    <!-- State when the button is disabled -->
    <item android:state_enabled="false" android:color="@color/gray_30"/>

    <!-- Default state (enabled but not pressed or focused) -->
    <item android:color="@color/white"/> <!-- Black in the default state -->

</selector>
