<!-- res/drawable/background_sidebar_menubutton.xml -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused state -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/gray_e0" /> <!-- Default transparent background -->
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/gray_e0" /> <!-- Blue border -->
            <padding android:bottom="0dp" android:left="0dp" android:right="0dp" android:top="0dp" />
        </shape>
    </item>

    <!-- Default state -->
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/white" /> <!-- Default transparent background -->
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/white" /> <!-- Blue border -->
        </shape>
    </item>

    <!-- Default state -->
    <item>
        <shape>
            <solid android:color="@color/transparent" /> <!-- Default transparent background -->
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/transparent"/>
        </shape>
    </item>
</selector>